# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Finnhub market data: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Server only. Used to record Stripe subscription state.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (TEST mode only): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
